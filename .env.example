# Get your token from @BotFather. Never commit real tokens.
TELEGRAM_BOT_TOKEN=

# Store user settings in SQLite. Relative paths use the working directory.
DATABASE_PATH=./data/bot.sqlite3

# Allow extra connection time beyond maiserver's roughly 15-second wait.
API_TIMEOUT_SECONDS=25

# Proxy for Telegram only; maiserver requests connect directly.
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:7890

# Optional: allowed Telegram user IDs, comma-separated. Leave empty to allow everyone.
ALLOWED_USER_IDS=

# Local HTTP listener for the NET gateway. cloudflared exposes this gateway, not maiserver port 8080.
WEBAPP_LISTEN_HOST=127.0.0.1
WEBAPP_LISTEN_PORT=8081

# NET static asset cache: isolated by user and account settings, shared across Mini App sessions.
# Memory only; cleared on restart. MAX_MB=0 disables the backend cache; TTL=0 disables static caching.
WEBAPP_CACHE_MAX_MB=64
# Static assets expire after 7 days by default. Browser caching is capped by the current session lifetime.
WEBAPP_CACHE_TTL_SECONDS=604800

# off: use an existing HTTPS reverse proxy, or the link-based flow if no public URL is set.
# quick: create a temporary trycloudflare.com URL. Leave WEBAPP_PUBLIC_URL empty.
# named: use a fixed domain. Set the public URL and tunnel token, and configure the service in Cloudflare.
# Install cloudflared first. The bot manages its startup and shutdown.
CLOUDFLARED_MODE=off
CLOUDFLARED_BIN=cloudflared
CLOUDFLARED_TUNNEL_TOKEN=
CLOUDFLARED_STARTUP_TIMEOUT_SECONDS=60
# Options: auto, http2, quic. Try http2 if UDP connections fail.
CLOUDFLARED_PROTOCOL=auto

# Browser-accessible HTTPS URL. Leave empty in quick mode; it is assigned automatically.
# In off mode, preserve this path when forwarding to the local listener above.
# WEBAPP_PUBLIC_URL=https://bot.example.com/net/
WEBAPP_PUBLIC_URL=

# INFO logs key events. DEBUG also logs NET request timings and cache status.
LOG_LEVEL=INFO
