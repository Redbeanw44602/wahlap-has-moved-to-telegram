# 从 @BotFather 获取，不要把真实 Token 提交到仓库。
TELEGRAM_BOT_TOKEN=

# 用户设置持久化到 SQLite；路径相对于启动目录。
DATABASE_PATH=./data/bot.sqlite3

# maiserver 本身最多等待约 15 秒，这里额外预留连接时间。
API_TIMEOUT_SECONDS=25

# 仅用于访问 Telegram，不会代理 maiserver 请求。
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:7890

# 可选：允许使用机器人的 Telegram 数字用户 ID，逗号分隔；留空允许所有人。
ALLOWED_USER_IDS=

# NET 网关的本地 HTTP 监听地址。cloudflared 只转发此网关，不转发 maiserver 8080。
WEBAPP_LISTEN_HOST=127.0.0.1
WEBAPP_LISTEN_PORT=8081

# NET 静态资源后端缓存：按用户及账号配置隔离，可跨小程序会话复用。
# 仅保存在内存中，重启后清空；MAX_MB=0 关闭后端缓存，TTL=0 关闭静态缓存。
WEBAPP_CACHE_MAX_MB=64
# 默认静态资源有效期 7 天；浏览器缓存仍不超过当前小程序会话有效期。
WEBAPP_CACHE_TTL_SECONDS=604800

# off：使用已有 HTTPS 反向代理，或在未填公开地址时使用兼容流程。
# quick：自动创建临时 trycloudflare.com 地址；下面的 WEBAPP_PUBLIC_URL 必须留空。
# named：使用固定域名；须填写公开地址和 Tunnel Token，并在 Cloudflare 配置服务地址。
# 先安装 cloudflared；机器人会管理它的启动和退出。
CLOUDFLARED_MODE=off
CLOUDFLARED_BIN=cloudflared
CLOUDFLARED_TUNNEL_TOKEN=
CLOUDFLARED_STARTUP_TIMEOUT_SECONDS=60
# 可用 auto、http2、quic；UDP 连接不通时可尝试 http2。
CLOUDFLARED_PROTOCOL=auto

# 浏览器可访问的 HTTPS 地址；quick 模式自动获取，无需填写。
# off 模式下外层代理须保留此路径，转发到上面的本地监听地址。
# WEBAPP_PUBLIC_URL=https://bot.example.com/net/
WEBAPP_PUBLIC_URL=

# INFO 记录关键操作；DEBUG 额外记录 NET 请求耗时与缓存状态。
LOG_LEVEL=INFO
